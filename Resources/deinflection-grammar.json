  "omittedPatterns": {
    "about": "Generated rules dropped by pattern: UniDic forms that are real but wrong for this purpose. Applied to generated rules only, never to deinflection-extras.json. Decided 2026-10-03 after reviewing every generated rule the hand-written file lacked.",
    "patterns": [
      {"why": "dialect (Kansai ます forms, これば)", "kanaIn": "まへ|まひょ|まっしゃろ|ませい|^まん$|^これば$"},
      {"why": "a する form read as an ichidan せる verb (した → せる)", "kanaIn": "^[しじ]", "kanaOut": "^せる$"},
      {"why": "the copula だ, not voiced た", "kanaIn": "^(じゃ|ぢゃ|で)$", "kanaOut": "^だ$"},
      {"why": "over-general: っ-forms are く only for 行く (in deinflection-extras.json), never ちる", "kanaIn": "^っ", "kanaOut": "^(く|ちる)$"},
      {"why": "over-general: ん-forms never come from a godan る verb", "kanaIn": "^ん", "kanaOut": "^る$", "rulesOut": ["v5"]},
      {"why": "over-general: い-forms → る (the honorific い-stems are in deinflection-extras.json)", "kanaIn": "^い.", "kanaOut": "^る$"},
      {"why": "single-kana casual volitional (行こ, 取ろ): on kana-only text it matches almost anything", "kanaIn": "^(お|こ|ご|そ|と|の|ぼ|も|ろ|よ)っ?$", "rulesOut": ["v5"]},
      {"why": "single-kana casual volitional, ichidan (見よっ)", "kanaIn": "^よっ$"},
      {"why": "single-kana fragments that are no word's ending: ん → る (godan), い → いる / る, か → かる, な → ぬ, じ → ずる, たか → たい", "kanaIn": "^(ん|い|か|な|じ)$|^たか$", "kanaOut": "^(る|いる|かる|ぬ|ずる|たい)$", "rulesOut": ["v5"]},
      {"why": "single-kana fragments that are no word's ending (other classes)", "kanaIn": "^(ん|い|か|な|じ)$|^たか$", "kanaOut": "^(いる|る|かる|ずる|たい)$"},
      {"why": "な → ぬ: a fragment, not ぬ's form (ん → ぬ for ません stays)", "kanaIn": "^な$", "kanaOut": "^ぬ$"},
      {"why": "emphatic spelling (高くっ…)", "kanaIn": "^くっ"}
    ]
  },
